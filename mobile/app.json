{
  "expo": {
    "name": "FUNY PIN",
    "slug": "funy-pin",
    "scheme": "funypin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {}
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치 주변의 카드샵을 찾기 위해 위치 권한이 필요합니다."
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/transparent-splash.png",
            "imageWidth": 1,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-apple-authentication"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kr.funypin.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "현재 위치 주변의 카드샵을 찾기 위해 위치 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "FUNY PIN은 프로필 이미지 또는 TALK 게시물에 사용자가 선택한 사진을 첨부하기 위해 사진 보관함에 접근합니다. 예: 프로필 사진을 변경하거나 TALK 게시물에 카드 사진을 추가할 때 사용됩니다.",
        "NSCameraUsageDescription": "FUNY PIN은 LIVE PIN 현장 제보에 사용자가 직접 촬영한 사진을 첨부하기 위해 카메라를 사용합니다. 예: 카드샵의 현재 상황을 촬영해 LIVE PIN 현장 제보에 사진을 추가할 때 사용됩니다.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/app-icon-light.png",
        "dark": "./assets/app-icon-dark.png"
      }
    },
    "android": {
      "package": "kr.funypin.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "funy-pin",
    "extra": {
      "eas": {
        "projectId": "777bf7d4-7850-48f4-8560-a04478afb878"
      }
    },
    "icon": "./assets/app-icon-light.png"
  }
}
